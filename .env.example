# ===== Database =====
DATABASE_URL="postgresql://simplecms:simplecms@localhost:5432/simplecms?schema=public"

# ===== App =====
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"
# Path panel admin. Ganti dengan kata yang sulit ditebak (min. 8 karakter).
# Dibaca saat runtime, jadi tidak perlu build ulang. Default: admin
ADMIN_PATH="admin"

# ===== Auth =====
# 32+ byte random string: openssl rand -base64 32
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"
SESSION_TTL_DAYS="7"

# ===== Seed (dipakai prisma/seed.ts) =====
SEED_ADMIN_EMAIL="admin@simplecms.local"
SEED_ADMIN_PASSWORD="Admin123!"

# ===== Analytics =====
# Salt harian untuk hash visitor: openssl rand -hex 32
ANALYTICS_SALT="dev-only-analytics-salt-change-me"
ANALYTICS_RETENTION_DAYS="365"

# ===== Cron =====
CRON_SECRET="dev-only-cron-secret"

# ===== Storage =====
STORAGE_DRIVER="local"
UPLOAD_DIR="./data/uploads"
MAX_IMAGE_MB="10"
MAX_DOCUMENT_MB="20"
