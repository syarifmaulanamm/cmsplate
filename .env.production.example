# ===== Wajib diisi =====
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgresql://simplecms:change-me-strong-password@db:5432/simplecms?schema=public

NEXT_PUBLIC_SITE_URL=https://cms.example.com

# Path panel admin (opsional, default: admin). Gunakan kata yang sulit ditebak,
# minimal 8 karakter, huruf kecil dan tanda hubung. Dibaca saat runtime.
ADMIN_PATH=

# openssl rand -base64 32
AUTH_SECRET=
SESSION_TTL_DAYS=7

# openssl rand -hex 32
ANALYTICS_SALT=
ANALYTICS_RETENTION_DAYS=365

# openssl rand -hex 24
CRON_SECRET=

# ===== Opsional =====
STORAGE_DRIVER=local
UPLOAD_DIR=/data/uploads
MAX_IMAGE_MB=10
MAX_DOCUMENT_MB=20

# Hanya dipakai jika menjalankan seed di lingkungan ini
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
